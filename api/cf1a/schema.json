        "namespace_id": {
          "type": "string",
          "pattern": "^(?!latest$)[A-Za-z0-9_-]{1,128}$"
        },
        "dataset_id": {
          "type": "string",
          "pattern": "^(?!latest$)[A-Za-z0-9_-]{1,128}$"
        },
        "display_name": {
          "type": "string",
          "maxLength": 4096
        },
        "schema_id": {
          "type": "string",
          "pattern": "^(?!latest$)[A-Za-z0-9_-]{1,128}$"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "tenant_id",
        "namespace_id",
        "dataset_id",
        "display_name",
        "schema_id",
        "schema_version",
        "schema_sha256",
        "fields"
