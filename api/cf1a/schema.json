        "name": {
          "type": "string",
          "pattern": "^(?!latest$)[A-Za-z0-9_-]{1,128}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "int8",
            "text",
            "bool"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "enum": [
            "value",
            "logical_id",
            "record_version"
          ]
        }
      },
      "required": [
        "field_id",
        "name",
        "type",
        "nullable",
        "role"
      ],
      "additionalProperties": false
    },
    "ResourceDescriptor": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^(?!latest$)[A-Za-z0-9_-]{1,128}$"
