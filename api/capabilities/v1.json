{
  "schema_version": 1,
  "product": "simple-rust-alpha",
  "entrypoint": "guradb query --config <file> --sql <SELECT>",
  "execution": "Rust only, local single-process",
  "source": "one local immutable Parquet SHA256",
  "sql": [
    "column projection and alias",
    "DISTINCT over supported projected column tuples; projected-output order then LIMIT; no DISTINCT ON",
    "typed comparisons/boolean/NULL",
    "bounded case-sensitive text column LIKE '%literal%' (1-128 UTF8 bytes; no inner wildcards/escape)",
    "column order",
    "LIMIT"
  ],
  "types": [
    "Int64",
    "Utf8",
    "Boolean"
  ],
  "limits": {
    "source_bytes": 33554432,
    "decoded_bytes": 67108864,
    "pool_bytes": 33554432,
    "result_bytes": 2097152,
    "rows": 1000,
    "timeout_ms_max": 10000
  },
  "unsupported": [
    "HTTP",
    "PG wire",
    "Python server",
    "object store",
    "JOIN/aggregate/functions",
    "ANN/BM25/graph",
    "training",
    "multi-tenant authorization",
    "distributed workers"
  ]
}
