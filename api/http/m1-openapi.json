{
  "openapi": "3.1.0",
  "x-guradb-capability-manifest": {
    "schema_version": 1,
    "scope": "source-tree",
    "path": "../capabilities/v1.json"
  },
  "info": {
    "title": "GuraDB bounded snapshot and retrieval service",
    "version": "0.2.0",
    "description": "Bounded M1/M2 alpha, optional local three-process execution. Long values are decimal strings. Source writes remain operator-only."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8081"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/search": {
      "post": {
        "operationId": "submitSearch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted fixed-view job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable dataset"
          },
          "429": {
            "description": "Budget exhausted"
          }
        }
      }
    },
    "/v1/scan": {
      "post": {
        "operationId": "submitScan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted fixed-view job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable dataset"
          },
          "429": {
            "description": "Budget exhausted"
          }
        }
      }
    },
    "/v1/exports": {
      "post": {
        "operationId": "submitExport",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted fixed-view job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable dataset"
          },
          "429": {
            "description": "Budget exhausted"
          }
        }
      }
    },
    "/v1/jobs/{query_id}": {
      "parameters": [
        {
          "name": "query_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getJob",
        "responses": {
          "200": {
            "description": "Current job state"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      },
      "delete": {
        "operationId": "cancelJob",
        "responses": {
          "200": {
            "description": "Request cancellation; terminal states remain"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/jobs/{query_id}/results": {
      "parameters": [
        {
          "name": "query_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getResults",
        "responses": {
          "200": {
            "description": "Immutable result with fixed read context"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/jobs/{query_id}/parquet": {
      "parameters": [
        {
          "name": "query_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "downloadParquet",
        "responses": {
          "200": {
            "description": "Authorized Parquet bytes"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/jobs/{query_id}/objects/{sha256}": {
      "parameters": [
        {
          "name": "query_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "sha256",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "downloadObject",
        "responses": {
          "200": {
            "description": "Authorized retained media bytes"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/jobs/{query_id}/retention": {
      "parameters": [
        {
          "name": "query_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "operationId": "releaseJob",
        "responses": {
          "200": {
            "description": "Release terminal job, result and training pin"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/datasets/{dataset_id}": {
      "parameters": [
        {
          "name": "dataset_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "describeDataset",
        "responses": {
          "200": {
            "description": "Schema, model and published context"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable"
          },
          "409": {
            "description": "Not ready"
          }
        }
      }
    },
    "/v1/graph": {
      "post": {
        "operationId": "submitGraph",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted fixed-view job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Unavailable dataset"
          },
          "429": {
            "description": "Budget exhausted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ReadContext": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "read_consistency",
          "data_revision_id",
          "source_versions",
          "index_versions"
        ],
        "description": "Required for successful data handles and every data result page. The same fixed revision, sources and index set are retained across pages. Versions describe what was read, not a global atomic moment. Catalog-only/constant queries use result_kind=metadata and omit this object.",
        "properties": {
          "read_consistency": {
            "type": "string",
            "enum": [
              "published",
              "data_committed"
            ]
          },
          "data_revision_id": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque aggregate revision binding every data source selected for this query; not an arbitrary single-table snapshot ID."
          },
          "read_view_id": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque view binding the aggregate revision and its required index bundle. All result pages preserve this exact context."
          },
          "source_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceVersion"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "index_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexVersion"
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "read_consistency"
              ],
              "properties": {
                "read_consistency": {
                  "const": "published"
                }
              }
            },
            "then": {
              "required": [
                "read_view_id"
              ]
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ]
      },
      "Search": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9 ]+$"
          },
          "vector": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            }
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "candidate_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "equals": {
                "type": [
                  "string",
                  "integer",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "field",
              "equals"
            ]
          },
          "vector_index": {
            "enum": [
              "exact",
              "ann"
            ]
          },
          "nprobes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "vector",
              "model"
            ]
          }
        ],
        "dependentRequired": {
          "vector": [
            "model"
          ],
          "model": [
            "vector"
          ],
          "vector_index": [
            "vector",
            "model"
          ],
          "nprobes": [
            "vector",
            "model",
            "vector_index"
          ]
        }
      },
      "Scan": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": []
      },
      "Export": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seed": {
            "type": "string",
            "maxLength": 128
          },
          "train_basis_points": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": []
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "kind": {
            "enum": [
              "search",
              "scan",
              "export",
              "graph"
            ]
          },
          "result_kind": {
            "const": "data"
          },
          "read_context": {
            "$ref": "#/components/schemas/ReadContext"
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "query_id",
          "status",
          "kind",
          "result_kind",
          "read_context",
          "error"
        ]
      },
      "SearchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "$ref": "#/components/schemas/Search"
          },
          "read_view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dataset_id",
          "query"
        ]
      },
      "ScanRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "$ref": "#/components/schemas/Scan"
          },
          "read_view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dataset_id",
          "query"
        ]
      },
      "ExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "$ref": "#/components/schemas/Export"
          },
          "read_view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dataset_id",
          "query"
        ]
      },
      "SourceVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "format",
          "version"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "description": "Opaque source snapshot, dataset version or immutable manifest identity. Not a cross-source transaction timestamp.",
            "minLength": 1
          }
        }
      },
      "IndexVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index_id",
          "version"
        ],
        "properties": {
          "index_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Graph": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_field",
          "target_field",
          "type_field",
          "seeds",
          "type"
        ],
        "properties": {
          "source_field": {
            "type": "string",
            "minLength": 1
          },
          "target_field": {
            "type": "string",
            "minLength": 1
          },
          "type_field": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "seeds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "direction": {
            "enum": [
              "in",
              "out",
              "both"
            ]
          },
          "max_edges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "max_fanout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "GraphRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dataset_id": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "$ref": "#/components/schemas/Graph"
          },
          "read_view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "dataset_id",
          "query"
        ]
      }
    }
  }
}
